<Window x:Class="CodexProfiles.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex Profiles — v0.6" Width="920" Height="680" MinWidth="820" MinHeight="540" Background="#F3F5FA" FontFamily="Segoe UI" FontSize="14">
<Window.Resources>
<SolidColorBrush x:Key="Ink" Color="#182D46"/><SolidColorBrush x:Key="Accent" Color="#4159D1"/><SolidColorBrush x:Key="Danger" Color="#A52A39"/>
<Style TargetType="Button"><Setter Property="Padding" Value="18,12"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Background" Value="#E9EDF7"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#182D46"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ListBoxItem"><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Padding="18" CornerRadius="10" BorderThickness="2" BorderBrush="#E1E5EF" Background="White"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#EDF0FF"/><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#8995D9"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Ink}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</Window.Resources>
<Grid>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Background="#182D46" Padding="30,24">
<Grid><StackPanel><TextBlock Text="CODEX / PROFILES" Foreground="#BBC9E5" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Tài khoản riêng. Chuyển đổi dễ dàng." Foreground="White" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel><TextBlock Text="v0.6" Foreground="#BBC9E5" HorizontalAlignment="Right" VerticalAlignment="Top"/></Grid>
</Border>
<Grid Grid.Row="1" Margin="30,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="White" CornerRadius="12" Padding="20">
<StackPanel><Label Content="Tên profile mới" Target="{Binding ElementName=ProfileName}" Foreground="{StaticResource Ink}" FontWeight="SemiBold" Padding="0,0,0,8"/><DockPanel><Button DockPanel.Dock="Right" Content="+ Thêm profile" Click="Add" Margin="12,0,0,0" Background="{StaticResource Accent}" Foreground="White"/><TextBox x:Name="ProfileName" Padding="12,9" VerticalContentAlignment="Center" MaxLength="80" BorderBrush="#CCD8E5" AutomationProperties.Name="Tên profile mới"/></DockPanel></StackPanel>
</Border>
<Grid Grid.Row="1" Margin="0,22,0,12"><TextBlock Text="PROFILE CỦA BẠN" Foreground="{StaticResource Ink}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Ctrl + click để chọn nhiều" Foreground="#53667B" FontSize="12" HorizontalAlignment="Right"/></Grid>
<Grid Grid.Row="2">
<TextBlock Text="Chưa có profile. Thêm tên ở phía trên để bắt đầu." Foreground="#53667B" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=Profiles,Path=Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
<ListBox x:Name="Profiles" SelectionMode="Extended" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Danh sách profile" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
<ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#E8EAFE" CornerRadius="8" Width="32" Height="32" VerticalAlignment="Center"><TextBlock Text="C" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#4159D1"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Foreground="#182D46" TextTrimming="CharacterEllipsis"/><Border HorizontalAlignment="Left" CornerRadius="6" Padding="8,4" Margin="0,8,0,0">
<Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#FFF0D5"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="● Đã dừng"><Setter Property="Background" Value="#E8EDF4"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="● Không kiểm tra được"><Setter Property="Background" Value="#FBE8EA"/></DataTrigger></Style.Triggers></Style></Border.Style>
<TextBlock Text="{Binding State}" FontSize="12" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#825100"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="● Đã dừng"><Setter Property="Foreground" Value="#42566E"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="● Không kiểm tra được"><Setter Property="Foreground" Value="#A52A39"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
</Border></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
</ListBox></Grid>
<StackPanel Grid.Row="3" Margin="0,18,0,0"><Border Background="#E8EDF6" CornerRadius="8" Padding="12"><TextBlock x:Name="Status" Text="Chọn profile để mở Codex. Profile mới cần đăng nhập lần đầu." TextWrapping="Wrap" Foreground="#182D46" AutomationProperties.LiveSetting="Polite"/></Border><DockPanel Margin="0,16,0,0"><Button DockPanel.Dock="Right" Content="Xóa profile…" Click="Remove" Foreground="{StaticResource Danger}" Background="#F7E6E8" Margin="10,0,0,0"/><WrapPanel><Button Content="Mở Codex đã chọn ↗" Click="Launch" Background="{StaticResource Accent}" Foreground="White"/><Button Content="Dừng đã chọn" Click="StopSelected" Background="#FFF0CF" Foreground="#6A4600"/><Button Content="Thư mục dữ liệu" Click="OpenData"/></WrapPanel></DockPanel></StackPanel>
</Grid></Grid></Window>
